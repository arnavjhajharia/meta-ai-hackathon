{
  "$defs": {
    "Amount": {
      "additionalProperties": false,
      "properties": {
        "object": {
          "title": "Object",
          "type": "string"
        },
        "measure": {
          "const": "work_area_fraction",
          "default": "work_area_fraction",
          "title": "Measure",
          "type": "string"
        },
        "teacher_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Teacher Value"
        },
        "tolerance": {
          "exclusiveMinimum": 0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "object",
        "tolerance"
      ],
      "title": "Amount",
      "type": "object"
    },
    "Calibration": {
      "additionalProperties": false,
      "properties": {
        "ran_at": {
          "format": "date-time",
          "title": "Ran At",
          "type": "string"
        },
