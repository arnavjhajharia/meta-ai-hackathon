          },
          "title": "Out Of View",
          "type": "array"
        }
      },
      "required": [
        "ran_at",
        "segmenter"
      ],
      "title": "Calibration",
      "type": "object"
    },
    "Completion": {
      "additionalProperties": false,
      "description": "How the learner side knows a step is finished.\n\nObject kinds are watched every frame by the segmenter. ``end_state`` is for steps where\nnothing new appears and only the shape or arrangement changes (a fold, a wrap, a knot): it\nis judged from one still at a settle moment, against the teacher's reference frame. Any\nkind may carry ``end_state`` text as a fallback description for that still check.",
      "properties": {
        "kind": {
          "enum": [
            "appears_in_work_area",
            "leaves_work_area",
            "coverage_change",
            "end_state",
            "manual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object"
        },
        "end_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End State"
        },
        "reference_frame_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Frame S"
        },
        "min_hold_s": {
          "default": 1.0,
          "minimum": 0,
          "title": "Min Hold S",
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Completion",
      "type": "object"
    },
